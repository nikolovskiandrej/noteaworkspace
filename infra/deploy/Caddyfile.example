# Reverse proxy + automatic TLS for the orchestrator (docs/DEPLOYMENT.md §5).
# Copy to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# The hostname below is this deployment's real one. Caddy obtains the certificate
# itself, so the DNS record must stay DNS-only: a Cloudflare-proxied (orange) record
# terminates TLS at Cloudflare and the ACME challenge never reaches this host.
#
# Caddy proxies WebSocket upgrades as-is, so browser terminals (wss://…/ws/workspaces/…)
# work through it without extra configuration. The REST API stays protected by the
# orchestrator's own bearer key; the bridge by connect tokens.
orchestrator.noteawork.com {
	encode gzip
	reverse_proxy 127.0.0.1:4100
}
