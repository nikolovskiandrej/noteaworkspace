# systemd unit for the Notea worker (docs/DEPLOYMENT.md §5).
# Run exactly ONE instance: claims are per process (docs/CURRENT_STATE.md, issue 8).
[Unit]
Description=Notea Workspace worker (agent tasks, integration, reaper)
After=network-online.target notea-orchestrator.service
Wants=network-online.target notea-orchestrator.service

[Service]
Type=simple
User=notea
Group=notea
WorkingDirectory=/opt/notea-workspace/app
EnvironmentFile=/opt/notea-workspace/app/.env
ExecStart=/usr/bin/npm run start -w @notea/worker
Restart=always
RestartSec=5
# On stop the worker drains its in-flight runs before closing the pool; give it
# room to do so. A run that outlasts this is killed and recovered as a stale run.
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/notea-workspace

[Install]
WantedBy=multi-user.target
