# Production environment for the Linux host running the orchestrator and the worker.
# Copy to /opt/notea-workspace/app/.env, chmod 600, owned by the service account.
# Generate every value marked GENERATE with: openssl rand -hex 32; values marked
# COPY already exist on the Vercel project and must be taken from there verbatim.
# See docs/DEPLOYMENT.md §2. Never commit the filled-in file.

# ---- orchestrator ----------------------------------------------------------------
PORT=4100
# Only the reverse proxy (Caddy) may reach the orchestrator directly.
HOST=127.0.0.1
LOG_LEVEL=info
# Shared with the web app (Vercel) and the worker. Already set on the deployed
# Vercel project: COPY that exact value, do not generate a new one.        COPY
ORCHESTRATOR_API_KEY=
# Signs short-lived browser connect tokens (>= 32 chars).                       GENERATE
CONNECT_TOKEN_SECRET=
# Root secret for per-workspace agent tokens; rotating it recreates containers. GENERATE
AGENT_TOKEN_SECRET=
WORKSPACE_IMAGE=notea/workspace:dev
WORKSPACE_NETWORK=notea-workspaces
# `network` on Linux; fall back to `published` if starting a workspace times out
# (docs/DEPLOYMENT.md §6).
AGENT_CONNECT_MODE=network
WORKSPACE_DEFAULT_CPUS=2
# Sized for a 4 vCPU / 8 GB host: the cap is not a reservation, so two workspaces
# at 4096 could together exhaust the host before either hit its own limit and the
# kernel would pick the victim. Raise it with the host (docs/DEPLOYMENT.md §5).
WORKSPACE_DEFAULT_MEMORY_MB=3072
WORKSPACE_DEFAULT_PIDS_LIMIT=2048
# Per-member agent uid range (docs/SECURITY_MODEL.md, "Agent identity isolation").
AGENT_UID_MIN=20001
AGENT_UID_MAX=29999
AGENT_GID=1000
# Must stay false anywhere reachable: the dev console mints tokens without auth.
DEV_CONSOLE=false

# ---- worker ----------------------------------------------------------------------
# Same database as the web app. A direct (non-pooled) URL is fine for the worker.
# REPLACE THIS. With the web app on Vercel the database must be managed and
# reachable from both (docs/DEPLOYMENT.md §1); the line below is only the shape
# for a Postgres on this host. Use the provider's direct, non-pooled URL here.
DATABASE_URL=postgres://notea:CHANGE-ME@127.0.0.1:5432/notea?sslmode=require
ORCHESTRATOR_URL=http://127.0.0.1:4100
# Encrypts stored provider credentials; must equal the web app's value, or every
# stored credential becomes undecryptable. COPY it from Vercel.                  COPY
CREDENTIALS_KEY=
# Concurrent agent CLIs in one container; each can hold several hundred MB.
WORKER_MAX_CONCURRENT_RUNS=2
# The worker queries Postgres every tick, so this is also what keeps a managed
# database awake. 15 s stays well inside the 2-minute stale-run cutoff and the
# 15 s per-run heartbeat, and only delays picking up a new task by that much.
WORKER_POLL_INTERVAL_MS=15000
WORKER_REAP_INTERVAL_MS=60000
