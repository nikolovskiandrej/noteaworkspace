# Copy to `.env` at the repository root. Never commit `.env`.

# ---- orchestrator (apps/orchestrator) ------------------------------------------
PORT=4100
HOST=127.0.0.1
LOG_LEVEL=info

# Shared secret the control plane (apps/web) presents on the orchestrator REST API.
ORCHESTRATOR_API_KEY=replace-with-a-long-random-string
# HS256 secret for short-lived browser connect tokens (>= 32 chars).
CONNECT_TOKEN_SECRET=replace-with-32-plus-random-characters
# Root secret from which per-workspace agent tokens are derived (>= 32 chars).
# Rotating it requires recreating workspace containers.
AGENT_TOKEN_SECRET=replace-with-32-plus-random-characters

WORKSPACE_IMAGE=notea/workspace:dev
WORKSPACE_NETWORK=notea-workspaces
# auto | network | published  (see apps/orchestrator/src/config.ts)
AGENT_CONNECT_MODE=auto
WORKSPACE_DEFAULT_CPUS=2
WORKSPACE_DEFAULT_MEMORY_MB=4096
WORKSPACE_DEFAULT_PIDS_LIMIT=2048
# Unix uid range that agent processes run as inside workspace containers. Each Notea
# user gets one uid from it (users.agent_uid), which is what keeps one member from
# reading another's provider credential out of /proc. Must stay clear of the image's
# `dev` user (uid 1000). AGENT_GID is the shared group that owns the project files.
# AGENT_UID_MIN=20001
# AGENT_UID_MAX=29999
# AGENT_GID=1000
# Browser terminal at http://127.0.0.1:4100/dev/console?workspaceId=demo (localhost development only).
DEV_CONSOLE=false

# ---- control plane (apps/web) ----------------------------------------------------
# Dev Postgres: docker compose -p notea-dev -f infra/compose/docker-compose.dev.yml up -d
DATABASE_URL=postgres://notea:notea@127.0.0.1:55432/notea
# Auth.js session signing secret (>= 32 random chars).
AUTH_SECRET=replace-with-32-plus-random-characters
# Where the web server reaches the orchestrator REST API (server to server).
ORCHESTRATOR_URL=http://127.0.0.1:4100
# Where browsers reach the orchestrator WebSocket (defaults to ORCHESTRATOR_URL).
# ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:4100
# Encrypts stored provider credentials (openssl rand -hex 32). Same value for web and worker.
CREDENTIALS_KEY=replace-with-64-hex-characters

# ---- development accounts (apps/web scripts/seed-dev-users.ts) --------------------
# `npm run seed:dev -w @notea/web` creates or refreshes these accounts. Values live in
# .env only; never commit a real password.
# NOTEA_DEV_PASSWORD=
# NOTEA_DEV_USERS=someone@example.com:Name,other@example.com:Other
# NOTEA_DEV_WORKSPACE=demo-project
# ---- worker (apps/worker) --------------------------------------------------------
# WORKER_MAX_CONCURRENT_RUNS=3
# WORKER_POLL_INTERVAL_MS=2000
# How often the worker reaps orphaned task worktrees/branches (ms); 0 disables.
# WORKER_REAP_INTERVAL_MS=60000
