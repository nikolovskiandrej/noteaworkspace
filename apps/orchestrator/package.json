{
  "name": "@notea/orchestrator",
  "version": "0.0.1",
  "private": true,
  "description": "Runtime service: manages workspace containers and bridges browser WebSockets to workspace agents",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run test/docker.e2e.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/orchestrator.mjs --log-level=warning"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@notea/protocol": "0.0.1",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@notea/workspace-agent": "0.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/ws": "^8.18.1"
  }
}
