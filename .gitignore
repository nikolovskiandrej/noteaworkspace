# dependencies
node_modules/

# build output
dist/
.next/
*.tsbuildinfo

# environment / secrets (never commit real values)
# Ignore every .env* except the tracked templates, so that pulling production
# values down (`vercel env pull <name>`) cannot make them committable.
.env*
!.env.example

# test / tooling artifacts
coverage/
.vitest/

# OS noise
.DS_Store
Thumbs.db
next-env.d.ts

# test scratch (redirected off the system drive by vitest.shared.ts)
.tmp/
